# Example environment file. Copy to .env (which is gitignored) and edit.
# These are only needed if you don't want to use the credentials.json file.

# Your Spotify Developer App Client ID (public; safe to share if you choose).
# Get one at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Override the default config dir (where credentials.json lives).
# Default: $XDG_CONFIG_HOME/spotify-wrapped-mcp or ~/.config/spotify-wrapped-mcp
# SPOTIFY_WRAPPED_MCP_CONFIG_DIR=

# Set to 1 to run integration tests (will hit api.spotify.com).
# SPOTIFY_INTEGRATION_TESTS=0
